<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the instrumentation fixture server for model downloads lives on loopback.
     Release builds carry no network security config, so the platform default (no cleartext) stands. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
